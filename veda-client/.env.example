# VAIDYA ERP — Frontend Environment Variables
# Copy this file to .env.local and fill in real values. Next.js only exposes
# variables prefixed NEXT_PUBLIC_ to the browser — everything here is public
# by design, so never put secrets (API keys, passwords) in this file.

# Backend API base URL (the NestJS server in veda-api)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Headless WordPress REST API base URL for the /blog pages.
# Point this at your WordPress site's REST API root, e.g.:
#   https://blog.vaidyaerp.in/wp-json/wp/v2
# Leave unset/empty to use the built-in blog (managed at /dashboard/blog by
# Super Admin) instead — the site falls back automatically either way.
NEXT_PUBLIC_WORDPRESS_API_URL=
